# === Node ===
# Do NOT set NODE_ENV here - it's managed automatically by frameworks
# Setting NODE_ENV=development breaks `next build` which requires NODE_ENV=production

# === Database ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reputation_manager_dev?schema=public"

# === Redis ===
REDIS_URL="redis://localhost:6379"

# === Auth ===
BETTER_AUTH_SECRET="replace-with-random-32-char-string-minimum"
BETTER_AUTH_URL="http://localhost:3333"

# === API ===
API_PORT=3333
API_URL="http://localhost:3333"

# === Frontend ===
NEXT_PUBLIC_API_URL="http://localhost:3333"

# === Twilio (opcional) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=http://localhost:3333/api/webhooks/twilio/sms

# === Google OAuth (opcional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Stripe (opcional - requerido para billing) ===
# Stripe secret key (starts with sk_test_ for testing, sk_live_ for production)
STRIPE_SECRET_KEY=

# Stripe publishable key (starts with pk_test_ for testing, pk_live_ for production)
STRIPE_PUBLISHABLE_KEY=

# Webhook secret from Stripe Dashboard (starts with whsec_)
# Create webhook at: https://dashboard.stripe.com/webhooks
# === Railway Deployment ===
RAILWAY_TOKEN=
# Endpoint: https://your-api.com/webhooks/stripe
# Events: customer.subscription.*, invoice.*, payment_intent.*
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (generated by: npx tsx scripts/stripe-setup-test-products.ts)
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=

# === WhatsApp Meta (opcional) ===
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=random-string-validation

# === Resend (opcional - email notifications) ===
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=
# Use onboarding@resend.dev for testing, or your verified domain email for production
RESEND_FROM_EMAIL=onboarding@resend.dev

# === Google Places API (opcional) ===
GOOGLE_PLACES_API_KEY=

# === URLs ===
FRONTEND_URL=http://localhost:4000

# === Sentry (opcional - error tracking) ===
# Get your DSN at https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# === CORS (producción) ===
# Comma-separated origins, e.g. https://app.reputationmanager.ec,https://api.reputationmanager.ec
CORS_ORIGINS=

# === Beta Mode ===
# Set to "true" to show feedback widget in production
NEXT_PUBLIC_BETA_MODE=true
